#!name=G1 ACQ
#!desc=v7.8：补充完整 Ultra 20TB/30TB 真实候选目录 + 三档置顶与顺序测试
#!system=ios

[Rule]
# 拦截 UDP 443，促使支持回退的 HTTP/3 请求改走 TCP。
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/aicuc/g1-acq@v7.8.0/g1-acq.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://cdn.jsdelivr.net/gh/aicuc/g1-acq@v7.8.0/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
