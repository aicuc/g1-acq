#!name=G1 ACQ
#!desc=v7.7：2TB 置顶 12months_eft、20TB 置顶 90p/75p+1month_eft、30TB 置顶 1month_eft+90p/75p
#!system=ios

[Rule]
# 拦截 UDP 443，促使支持回退的 HTTP/3 请求改走 TCP。
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/aicuc/g1-acq/main/g1-acq.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://raw.githubusercontent.com/aicuc/g1-acq/main/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
